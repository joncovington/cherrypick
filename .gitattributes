# Shell scripts must keep LF even when checked out on Windows, or bash fails on the first line
# ("bad interpreter: /usr/bin/env bash^M"). Windows batch files keep CRLF.
*.sh  text eol=lf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# A release ZIP has no .git, so the console reads its version from this file. GitHub fills in the
# $Format line from `git describe` when it builds the archive; in a git checkout it stays a template.
.git_archival.txt export-subst
